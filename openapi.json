
{
  "openapi": "3.0.0",
  "info": {
    "title": "CAB System - Ride-Hailing Platform API",
    "description": "Đặc tả API hệ thống đặt xe trực tuyến (CAB System) phục vụ 3 nhóm tác nhân: Khách hàng (Customer), Tài xế (Driver) và Nhân viên vận hành (Admin/Operator).",
    "version": "1.0.0",
    "contact": {
      "name": "CAB System Engineering Team"
    }
  },
  "servers": [
    {
      "url": "https://api.cabsystem.local/api/v1",
      "description": "Development / Staging Server"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Đăng ký tài khoản (Khách hàng / Tài xế)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Số điện thoại hoặc email đã tồn tại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Đăng nhập hệ thống (Lấy JWT Access Token)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sai thông tin đăng nhập",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rides": {
      "post": {
        "tags": ["Customer - Rides"],
        "summary": "Khách hàng tạo yêu cầu đặt chuyến đi",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRideRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo yêu cầu thành công, hệ thống bắt đầu tìm tài xế",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideResponse"
                }
              }
            }
          },
          "400": {
            "description": "Thông tin điểm đón/trả hoặc loại xe không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rides/{id}": {
      "get": {
        "tags": ["Customer - Rides"],
        "summary": "Theo dõi trạng thái chi tiết của chuyến đi theo thời gian thực",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Mã chuyến đi (Ride ID)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy thông tin chuyến đi thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RideDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy chuyến đi"
          }
        }
      }
    },
    "/rides/{id}/cancel": {
      "post": {
        "tags": ["Customer - Rides"],
        "summary": "Khách hàng hủy chuyến đi",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { "type": "string", "example": "Thay đổi lịch trình cá nhân" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hủy chuyến thành công"
          }
        }
      }
    },
    "/rides/{id}/feedback": {
      "post": {
        "tags": ["Customer - Rides"],
        "summary": "Khách hàng đánh giá và gửi phản hồi sau khi hoàn thành chuyến",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rating"],
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
                  "comment": { "type": "string", "example": "Tài xế lái xe cẩn thận, lịch sự" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đánh giá thành công"
          }
        }
      }
    },
    "/driver/status": {
      "patch": {
        "tags": ["Driver - Operations"],
        "summary": "Tài xế bật/tắt trạng thái sẵn sàng nhận chuyến",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["ONLINE", "OFFLINE", "BUSY"],
                    "example": "ONLINE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật trạng thái hoạt động thành công"
          }
        }
      }
    },
    "/driver/location": {
      "post": {
        "tags": ["Driver - Operations"],
        "summary": "Cập nhật tọa độ GPS định kỳ của tài xế",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật vị trí thành công"
          }
        }
      }
    },
    "/driver/rides/{id}/response": {
      "post": {
        "tags": ["Driver - Operations"],
        "summary": "Tài xế chấp nhận hoặc từ chối chuyến được đề xuất",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["ACCEPT", "REJECT"],
                    "example": "ACCEPT"
                  },
                  "reason": { "type": "string", "example": "Quá xa điểm đón" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Xử lý phản hồi của tài xế thành công"
          }
        }
      }
    },
    "/driver/rides/{id}/status": {
      "patch": {
        "tags": ["Driver - Operations"],
        "summary": "Tài xế cập nhật tiến trình chuyến đi",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["ARRIVED_AT_PICKUP", "PICKED_UP", "DROPPED_OFF", "COMPLETED"],
                    "example": "ARRIVED_AT_PICKUP"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật tiến trình thành công"
          }
        }
      }
    },
    "/payments/checkout": {
      "post": {
        "tags": ["Payments"],
        "summary": "Khởi tạo thanh toán cho chuyến đi",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ride_id", "payment_method"],
                "properties": {
                  "ride_id": { "type": "string", "example": "ride_98234" },
                  "payment_method": {
                    "type": "string",
                    "enum": ["CASH", "E_WALLET", "CREDIT_CARD_GATEWAY"],
                    "example": "E_WALLET"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Khởi tạo giao dịch thanh toán thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payment_id": { "type": "string", "example": "pay_54321" },
                    "status": { "type": "string", "example": "PENDING" },
                    "redirect_url": { "type": "string", "example": "https://gateway.payment.vn/pay/token123" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/rides": {
      "get": {
        "tags": ["Admin / Operator"],
        "summary": "Xem danh sách và giám sát các chuyến đi đang diễn ra",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách chuyến đi thành công"
          },
          "403": {
            "description": "Không có quyền quản trị viên"
          }
        }
      }
    },
    "/admin/reports/analytics": {
      "get": {
        "tags": ["Admin / Operator"],
        "summary": "Báo cáo thống kê: Doanh thu, số chuyến, tỷ lệ hủy, hiệu suất tài xế",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "from_date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "to_date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": {
          "200": {
            "description": "Lấy báo cáo thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsReportResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["phone_number", "password", "full_name", "role"],
        "properties": {
          "phone_number": { "type": "string", "example": "0987654321" },
          "email": { "type": "string", "example": "user@gmail.com" },
          "password": { "type": "string", "example": "Password123@" },
          "full_name": { "type": "string", "example": "Nguyễn Văn A" },
          "role": { "type": "string", "enum": ["CUSTOMER", "DRIVER"], "example": "CUSTOMER" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["phone_number", "password"],
        "properties": {
          "phone_number": { "type": "string", "example": "0987654321" },
          "password": { "type": "string", "example": "Password123@" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "token_type": { "type": "string", "example": "Bearer" },
          "user_id": { "type": "string", "example": "usr_1001" },
          "role": { "type": "string", "example": "CUSTOMER" }
        }
      },
      "CreateRideRequest": {
        "type": "object",
        "required": ["pickup_lat", "pickup_lng", "pickup_address", "dropoff_lat", "dropoff_lng", "dropoff_address", "vehicle_type"],
        "properties": {
          "pickup_lat": { "type": "number", "example": 10.8231 },
          "pickup_lng": { "type": "number", "example": 106.6872 },
          "pickup_address": { "type": "string", "example": "12 Nguyễn Văn Bảo, Gò Vấp, TP.HCM" },
          "dropoff_lat": { "type": "number", "example": 10.7769 },
          "dropoff_lng": { "type": "number", "example": 106.7009 },
          "dropoff_address": { "type": "string", "example": "Chợ Bến Thành, Quận 1, TP.HCM" },
          "vehicle_type": { "type": "string", "enum": ["CAB_4_SEATS", "CAB_7_SEATS"], "example": "CAB_4_SEATS" }
        }
      },
      "RideResponse": {
        "type": "object",
        "properties": {
          "ride_id": { "type": "string", "example": "ride_98234" },
          "status": { "type": "string", "example": "FINDING_DRIVER" },
          "estimated_fare": { "type": "number", "example": 125000 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "RideDetailResponse": {
        "type": "object",
        "properties": {
          "ride_id": { "type": "string", "example": "ride_98234" },
          "status": {
            "type": "string",
            "enum": ["FINDING_DRIVER", "DRIVER_ACCEPTED", "DRIVER_ARRIVED", "IN_PROGRESS", "COMPLETED", "CANCELLED"],
            "example": "DRIVER_ACCEPTED"
          },
          "driver_info": {
            "type": "object",
            "properties": {
              "driver_name": { "type": "string", "example": "Trần Văn B" },
              "phone_number": { "type": "string", "example": "0912345678" },
              "vehicle_plate": { "type": "string", "example": "59A-123.45" },
              "vehicle_model": { "type": "string", "example": "Toyota Vios 2024" },
              "current_lat": { "type": "number", "example": 10.8220 },
              "current_lng": { "type": "number", "example": 106.6850 }
            }
          },
          "eta_minutes": { "type": "integer", "example": 4 },
          "fare_amount": { "type": "number", "example": 125000 }
        }
      },
      "LocationUpdate": {
        "type": "object",
        "required": ["lat", "lng"],
        "properties": {
          "lat": { "type": "number", "example": 10.8225 },
          "lng": { "type": "number", "example": 106.6860 },
          "heading": { "type": "number", "example": 180.5 }
        }
      },
      "AnalyticsReportResponse": {
        "type": "object",
        "properties": {
          "total_rides": { "type": "integer", "example": 1540 },
          "completed_rides": { "type": "integer", "example": 1420 },
          "cancelled_rides": { "type": "integer", "example": 120 },
          "cancellation_rate": { "type": "number", "example": 7.79 },
          "total_revenue": { "type": "number", "example": 185000000 },
          "active_drivers": { "type": "integer", "example": 85 }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Thao tác thành công" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "RESOURCE_NOT_FOUND" },
              "message": { "type": "string", "example": "Mô tả chi tiết lỗi" }
            }
          }
        }
      }
    }
  }
}
